// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ---------------------------------------------------------------------------
// Better Auth models (email + password accounts). Field shapes follow what
// `npx @better-auth/cli generate` produces; timezone is a custom addition
// registered as a Better Auth `additionalFields` entry in src/lib/auth.ts.
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  timezone      String   @default("UTC")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions          Session[]
  accounts          Account[]
  plans             Plan[]
  deadlines         Deadline[]
  pushSubscriptions PushSubscription[]
  hourLogs          HourLog[]
  missedDeadlines   MissedDeadline[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id           String    @id @default(cuid())
  userId       String
  accountId    String
  providerId   String
  password     String?
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Domain models
// ---------------------------------------------------------------------------

enum RecurrenceType {
  NONE
  DAILY
  WEEKLY
  MULTI_WEEKLY
  MONTHLY
}

model Plan {
  id          String     @id @default(cuid())
  name        String
  description String?
  resolvedAt  DateTime?
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  deadlines   Deadline[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId])
}

model Deadline {
  id             String         @id @default(cuid())
  title          String
  description    String?
  recurrenceType RecurrenceType

  // one-time only (recurrenceType = NONE): a specific calendar date, stored
  // as UTC midnight of that date. Never carries a time-of-day.
  dueDate DateTime?

  // Optional wall-clock time the deadline is due at, "HH:mm" (24-hour), independent
  // of timezone/date math — applies to any recurrence type.
  dueTime String?

  // recurring anchors. daysOfWeek uses JS Date.getDay() convention (0=Sun..6=Sat):
  // WEEKLY needs exactly 1 entry, MULTI_WEEKLY needs 2 or more.
  daysOfWeek Int[] @default([])

  // daysOfMonth is 1-31, clamped to the last day of shorter months.
  // MONTHLY needs exactly 1 entry.
  daysOfMonth Int[] @default([])

  isActive Boolean @default(true)

  // "current period only" completion tracking: overwritten each period
  // rather than accumulated in a history table (no streak/history feature).
  lastCompletedPeriodKey String?
  lastCompletedAt        DateTime?

  // Same current-period-only pattern for "couldn't complete it" — drives
  // whether *this* occurrence is hidden from the dashboard. Unlike done/
  // notified, missed occurrences are also durably logged (see
  // MissedDeadline) so the record survives past the period rolling over.
  lastMissedPeriodKey String?
  lastMissedAt        DateTime?

  // Push-notification dedupe, same overwrite-per-period pattern (no log table).
  lastNotifiedPeriodKey String?

  planId String?
  plan   Plan?   @relation(fields: [planId], references: [id], onDelete: SetNull)
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  missedLogs MissedDeadline[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([planId])
}

// Durable record of occurrences the user marked "missed" — kept even after
// the deadline rolls into its next period (unlike Deadline.lastMissedPeriodKey,
// which only reflects the *current* period). `title` is a snapshot so the
// record still makes sense if the deadline is later renamed.
model MissedDeadline {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deadlineId String
  deadline   Deadline @relation(fields: [deadlineId], references: [id], onDelete: Cascade)
  title      String
  periodKey  String
  missedAt   DateTime @default(now())

  @@unique([deadlineId, periodKey])
  @@index([userId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// One freeform note per hour of a calendar day ("what did I do at 3pm").
// `date` is a calendar date, not an instant — stored as UTC midnight of that
// date, same convention as Deadline.dueDate. `hour` is 0-23, a plain label
// for a slot within that already-established day (no timezone conversion
// needed on top of it).
model HourLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  hour      Int
  note      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date, hour])
  @@index([userId, date])
}
